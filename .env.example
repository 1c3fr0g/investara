AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Gemini AI (Ambil gratis di https://aistudio.google.com/)
GEMINI_API_KEY=
# Opsional. Tanpa pengaturan ini, aplikasi memakai gemini-flash-lite-latest.
# GEMINI_MODEL=

# Wajib di Vercel. Untuk SQLite lokal, biarkan keduanya kosong.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Wajib untuk pemindaian alert dan simulasi terjadwal di Vercel. Gunakan rahasia acak terpisah.
CRON_SECRET=

# Opsional. Alamat kontak publik pengelola untuk Web Push, misalnya mailto:ops@domain-anda.id
ALERT_PUSH_SUBJECT=
# Set ke 0 jika pemindaian latar belakang perlu dimatikan.
# ALERT_MONITOR_ENABLED=0

# Opsional. Kunci server Invezgo untuk Ringkasan Broker dan laporan Insider di detail saham.
INVEZGO_API_KEY=
